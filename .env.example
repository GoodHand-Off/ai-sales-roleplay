# Copy this file to .env.local and fill in OPENAI_API_KEY. Everything else has a default.

# Required. An OpenAI API key from a project with Realtime access and billing.
# Create one at https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Voice model for the homeowner. It must have prices in lib/pricing.ts.
OPENAI_REALTIME_MODEL=gpt-realtime-2.1-mini

# Model that transcribes the rep's speech. It must have prices in lib/pricing.ts.
OPENAI_TRANSCRIBE_MODEL=gpt-transcribe

# Model that writes the coaching scorecard. It must support structured outputs.
OPENAI_COACHING_MODEL=gpt-6-luna

# Hard limit on one call, in seconds (30 to 230). The server hangs up at this point
# whatever the browser does.
SESSION_MAX_SECONDS=180

# The server holds each call's estimated cost to this many dollars (up to 20),
# hanging up while one more worst-case reply still fits. It must cover two
# worst-case replies: at least 0.21 on gpt-realtime-2.1-mini, 0.68 on
# gpt-realtime-2.1. An estimate from OpenAI's reported usage; see the README.
MAX_CALL_COST_USD=0.50

# Calls allowed per day across all visitors (rolling 24 hours).
MAX_CALLS_PER_DAY=100

# --- Deploying ---

# The site's origin(s), comma-separated, e.g. https://practice.example.com.
# Not needed on localhost or Vercel. Required anywhere else, or the API refuses requests.
APP_ORIGIN=

# Set to true only behind your own reverse proxy that sets X-Forwarded-For.
# Then per-visitor limits use the client IP; otherwise all visitors share one limit.
TRUST_PROXY=

# Optional. An Upstash-compatible Redis REST endpoint. Shares rate limits across
# server instances, and lets a restarted server hang up calls it was watching.
RATE_LIMIT_REDIS_REST_URL=
RATE_LIMIT_REDIS_REST_TOKEN=
